{
  "name": "@zrzring/dsh-desktop-notifications",
  "version": "0.0.1",
  "type": "module",
  "engines": {
    "dsh": ">=0.2.1-rc.1 <0.3.0"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ZRZRING/dsh-plugins.git",
    "directory": "packages/dsh-desktop-notifications"
  },
  "keywords": [
    "dsh-plugin",
    "dsh-bundle",
    "notification",
    "windows"
  ],
  "exports": {
    ".": "./index.js",
    "./config.json": "./config.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "config.json",
    "README.md",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
